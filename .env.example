# Copy to .env on the VPS and fill in real values. Never commit the real .env file.

# Postgres password used by both the db and backend services
POSTGRES_PASSWORD=change_me_to_something_long_and_random

# JWT signing secret - must be at least 32 characters
JWT_SECRET=change_me_to_a_random_32plus_character_string

# Public domain Caddy will request a TLS certificate for.
# Own a domain: use a subdomain like api.yourdomain.com (point an A record at the VPS IP first).
# No domain: use <VPS_IP>.sslip.io (e.g. 203.0.113.5.sslip.io) - resolves automatically, no DNS setup needed.
API_DOMAIN=api.yourdomain.com

# Email Caddy sends to Let's Encrypt for certificate expiry notices
ACME_EMAIL=you@example.com
